{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenClicky",
  "version": "2.0.0",
  "identifier": "app.openclicky.desktop",
  "build": {
    "frontendDist": "ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenClicky",
        "width": 900,
        "height": 640,
        "visible": true
      },
      {
        "label": "overlay",
        "title": "overlay",
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": true,
        "focus": false,
        "fullscreen": true,
        "url": "overlay.html"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'none'; script-src 'self' 'unsafe-inline'"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/icon.png", "icons/icon.ico"]
  }
}
